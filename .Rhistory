mk_lookback_d <- function(dat, k) {
dat %>%
group_by(opp, year) %>%
arrange(date, .by_group = TRUE) %>%
mutate(across(
all_of(num_cols),
~ slide_dbl(lag(.x), mean, .before = k - 1, .complete = TRUE),
.names = "{.col}_avg_lb{k}"
)) %>%
ungroup() %>%
select(opp, date, ends_with(paste0("lb", k)))
}
lookbacks_d <- set_names(map(2:8, ~ mk_lookback_d(drive_sum, .x)),
paste0("lb", 2:8))
lb_d2 <- lookbacks_d$lb2
lb_d3 <- lookbacks_d$lb3
lb_d4 <- lookbacks_d$lb4
lb_d5 <- lookbacks_d$lb5
lb_d6 <- lookbacks_d$lb6
lb_d7 <- lookbacks_d$lb7
lb_d8 <- lookbacks_d$lb8
View(lb_d6)
dfs <- c("lb_d2","lb_d3","lb_d4","lb_d5","lb_d6","lb_d7","lb_d8",
"lb_o2","lb_o3","lb_o4","lb_o5","lb_o6","lb_o7","lb_o8")
for (nm in dfs) {
df <- get(nm)
df <- df %>% drop_na()
assign(nm, df, envir = .GlobalEnv)
}
View(lb_d2)
View(lb_o2)
